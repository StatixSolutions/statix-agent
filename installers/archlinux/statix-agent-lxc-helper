#!/usr/bin/env bash
set -Eeuo pipefail

readonly STATE_ROOT="${STATIX_AGENT_STATE_DIR:-${STATE_DIRECTORY:-/var/lib/statix-agent}}"
readonly STORAGE_ROOT="$STATE_ROOT/lxc/containers"
export HOME="$STATE_ROOT/lxc"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export LXC_CACHE_PATH="$HOME/.cache/lxc"

fail() { printf 'statix-agent-lxc: %s\n' "$*" >&2; exit 2; }
[[ $# -ge 1 ]] || fail "missing operation"
operation="$1"; shift
case "$operation" in
  network-ensure|lxc-create|lxc-start|lxc-wait|lxc-attach|lxc-stop|lxc-destroy) ;;
  *) fail "operation is not allowed: $operation" ;;
esac

if [[ "$operation" == network-ensure ]]; then
  bridge="${STATIX_LXC_NETWORK_BRIDGE:-lxcbr0}"
  [[ "$bridge" =~ ^[a-zA-Z0-9_.-]{1,15}$ ]] || fail "invalid bridge name"
  gateway_cidr="${STATIX_LXC_NETWORK_GATEWAY:-10.0.3.1/24}"
  gateway="${gateway_cidr%%/*}"
  prefix="${gateway_cidr##*/}"
  [[ "$gateway" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ && "$prefix" =~ ^[0-9]+$ && "$prefix" -le 30 ]] || fail "invalid network gateway"

  command -v ip >/dev/null 2>&1 || fail "ip is required to configure LXC networking"
  command -v sysctl >/dev/null 2>&1 || fail "sysctl is required to configure LXC networking"
  command -v dnsmasq >/dev/null 2>&1 || fail "dnsmasq is required to configure LXC networking"
  command -v ss >/dev/null 2>&1 || fail "ss is required to configure LXC networking"
  command -v iptables >/dev/null 2>&1 || fail "iptables is required to configure LXC networking"

  ip link show dev "$bridge" >/dev/null 2>&1 || ip link add name "$bridge" type bridge
  ip -4 addr show dev "$bridge" | grep -q ' inet ' || ip addr add "$gateway_cidr" dev "$bridge"
  ip link set dev "$bridge" up
  sysctl -w net.ipv4.ip_forward=1 >/dev/null

  subnet="$(ip -4 route show dev "$bridge" scope link | awk 'NR == 1 {print $1}')"
  [[ -n "$subnet" ]] || fail "could not determine subnet for $bridge"
  egress="$(ip -4 route show default | awk 'NR == 1 {for (i = 1; i <= NF; i++) if ($i == "dev") {print $(i + 1); exit}}')"
  [[ -n "$egress" ]] || fail "could not determine default IPv4 egress interface"

  if ! iptables -t nat -C POSTROUTING -s "$subnet" -o "$egress" -j MASQUERADE >/dev/null 2>&1; then
    iptables -t nat -A POSTROUTING -s "$subnet" -o "$egress" -j MASQUERADE
  fi

  if ! ss -lunH 2>/dev/null | grep -Eq "[[:space:]](${gateway//./\\.}|0\\.0\\.0\\.0|\\*):53[[:space:]]"; then
    runtime_dir="/run/statix-agent"
    install -d -m 0755 "$runtime_dir"
    pidfile="$runtime_dir/lxc-dnsmasq.pid"
    if [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
      fail "agent-managed dnsmasq is running but DNS is not listening on $gateway"
    fi
    rm -f "$pidfile"
    dnsmasq --conf-file=/dev/null --interface="$bridge" --bind-interfaces --listen-address="$gateway" \
      --no-dhcp-interface="$bridge" --pid-file="$pidfile"
  fi
  exit 0
fi
name=""; path=""
for ((index = 1; index <= $#; index++)); do
  arg="${!index}"
  case "$arg" in
    -n) next=$((index + 1)); (( next <= $# )) || fail "-n requires a value"; name="${!next}"; [[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}$ ]] || fail "invalid container name" ;;
    -P) next=$((index + 1)); (( next <= $# )) || fail "-P requires a value"; path="${!next}"; [[ "$path" == "$STORAGE_ROOT" ]] || fail "invalid LXC storage path" ;;
  esac
done
[[ -n "$name" ]] || fail "container name is required"
[[ -n "$path" ]] || fail "LXC storage path is required"
install -d -m 0755 "$STORAGE_ROOT" "$HOME/.cache" "$HOME/.cache/lxc" "$HOME/.config" "$HOME/.local/share"
if [[ "$operation" == lxc-attach ]]; then
  found_separator=0; for arg in "$@"; do [[ "$arg" == "--" ]] && found_separator=1; done
  (( found_separator == 1 )) || fail "attach requires -- command separator"
fi
if [[ "$operation" == lxc-create && " $* " != *" -t download "* ]]; then fail "create must use the download template"; fi
if [[ "$operation" == lxc-create ]]; then
  if "/usr/bin/$operation" "$@"; then
    status=0
  else
    status=$?
  fi
  (( status == 0 )) || exit "$status"
  chmod 0755 "$STORAGE_ROOT/$name"
  config="$STORAGE_ROOT/$name/config"
  if [[ -n "${SUDO_UID:-}" && -n "${SUDO_GID:-}" && -f "$config" ]]; then
    chown "$SUDO_UID:$SUDO_GID" "$config"
  fi
  chmod 0640 "$config"
  exit 0
fi
exec "/usr/bin/$operation" "$@"
