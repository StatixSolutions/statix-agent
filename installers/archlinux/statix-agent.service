[Unit]
Description=Statix Agent
Documentation=https://statix.pettersson.online/docs/nodes/manual-installation
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=STATIX_AGENT_CONFIG=/etc/statix/agent.json
Environment=STATIX_VERSION_FILE=/opt/statix/version.json
Environment=STATIX_APPLY_WIREGUARD=0
EnvironmentFile=-/etc/statix/agent.env
ExecStart=/usr/local/bin/statix-agent run
Restart=always
RestartSec=5s
KillSignal=SIGINT
# Deployed project runtimes are intentionally longer-lived than the agent
# control plane. Keep them alive while the agent is upgraded or restarted.
KillMode=process
TimeoutStopSec=20s

User=statix-agent
Group=statix-agent

# Run the main agent unprivileged; privileged actions should be delegated to narrow helpers.
NoNewPrivileges=false
PrivateTmp=true
PrivateDevices=false
ProtectHome=read-only
ProtectSystem=strict
# The agent does not need access to these host-only trees. Keep the paths it
# actually consumes explicitly allow-listed below.
InaccessiblePaths=/boot /home /media /mnt /root /srv
# LXC needs these paths writable while creating and mounting guests.
ReadWritePaths=/run/lxc -/usr/lib/x86_64-linux-gnu/lxc/rootfs -/usr/lib/aarch64-linux-gnu/lxc/rootfs
ProtectControlGroups=false
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectClock=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=false
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadOnlyPaths=/etc/statix /opt/statix
RuntimeDirectory=statix-agent
StateDirectory=statix-agent

[Install]
WantedBy=multi-user.target
