[Unit]
Description=Statix Agent
Documentation=https://statix.pettersson.online/docs/nodes/manual-installation
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=STATIX_AGENT_CONFIG=/etc/statix/agent.json
Environment=STATIX_VERSION_FILE=/opt/statix/version.json
Environment=STATIX_APPLY_WIREGUARD=0
EnvironmentFile=-/etc/statix/agent.env
ExecStart=/usr/local/bin/statix-agent run
Restart=always
RestartSec=5s
KillSignal=SIGINT
# Deployed project runtimes are intentionally longer-lived than the agent
# control plane. Keep them alive while the agent is upgraded or restarted.
KillMode=process
TimeoutStopSec=20s

User=statix-agent
Group=statix-agent

# Run the main agent unprivileged; privileged actions should be delegated to narrow helpers.
NoNewPrivileges=false
PrivateTmp=true
PrivateDevices=false
ProtectSystem=strict
# Keep these host trees masked even if they do not exist when the service starts.
TemporaryFileSystem=/boot:ro /home:ro /media:ro /mnt:ro /root:ro /srv:ro
# LXC needs its runtime and rootfs mountpoints writable. The narrow privileged
# network helper also writes the generated stream configuration below /etc/nginx.
ReadWritePaths=/run/lxc /run/statix-agent -/usr/lib/x86_64-linux-gnu/lxc/rootfs -/usr/lib/aarch64-linux-gnu/lxc/rootfs -/etc/nginx
ProtectControlGroups=false
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectClock=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=false
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadOnlyPaths=/etc/statix /opt/statix
RuntimeDirectory=statix-agent
StateDirectory=statix-agent

[Install]
WantedBy=multi-user.target
