[Unit]
Description=Statix Agent
Documentation=https://statix.pettersson.online/docs/nodes/manual-installation
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=STATIX_AGENT_CONFIG=/etc/statix/agent.json
Environment=STATIX_VERSION_FILE=/opt/statix/version.json
Environment=STATIX_APPLY_WIREGUARD=0
Environment=XDG_RUNTIME_DIR=/run/statix-agent
EnvironmentFile=-/etc/statix/agent.env
ExecStart=/usr/local/bin/statix-agent run
Restart=always
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=20s

User=statix-agent
Group=statix-agent

# The agent uses a narrow root helper for privileged Docker-in-LXC jobs and
# QEMU/KVM for microVM jobs.
NoNewPrivileges=false
Delegate=yes
PrivateTmp=true
PrivateDevices=false
ProtectHome=read-only
ProtectSystem=strict
# LXC needs these paths writable while creating and mounting guests.
ReadWritePaths=/run/lxc -/usr/lib/x86_64-linux-gnu/lxc/rootfs -/usr/lib/aarch64-linux-gnu/lxc/rootfs
ProtectControlGroups=false
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectClock=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=false
RestrictRealtime=true
RestrictNamespaces=false
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadOnlyPaths=/etc/statix /opt/statix
RuntimeDirectory=statix-agent
RuntimeDirectoryMode=0700
StateDirectory=statix-agent

[Install]
WantedBy=multi-user.target
